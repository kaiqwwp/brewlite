# Sao chép thành .env khi cần đổi giá trị mặc định. KHÔNG commit file .env.
# ---- docker compose (local) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brewlite
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- API (apps/api), chạy không dùng Docker ----
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/brewlite
# PORT=3001
# DB_MIGRATE=true        # chạy migration khi khởi động (mặc định true)
# DB_SSL=false           # true khi CSDL yêu cầu TLS
# SEED=true              # nạp dữ liệu mẫu nếu bảng rỗng
# LOG_FORMAT=text        # json ở production
# STAFF_EMAIL=staff@brewlite.local
# STAFF_PASSWORD=staff123

# ---- Production: đặt trên Render (Environment) và GitHub (Secrets), không ghi vào repo ----
# NODE_ENV=production, DATABASE_URL (Internal URL của Render Postgres), JWT_SECRET (>= 32 ký tự),
# CORS_ORIGIN=https://<web>.onrender.com, STAFF_PASSWORD
