sequenceDiagram
  autonumber
  actor KH as Khách hàng
  actor NV as Nhân viên (STAFF)
  participant OC as OrdersController
  participant OS as OrdersService
  participant ST as StockService
  participant DB as PostgreSQL
  rect rgb(246,235,221)
  Note over KH,DB: A. Khách hủy đơn
  KH->>OC: POST /orders/:id/cancel
  OC->>OS: cancel(id, user)
  OS->>DB: SELECT order (kiểm tra chủ đơn, sai → 403)
  OS->>DB: BEGIN, SELECT order FOR UPDATE
  OS->>OS: assertTransition(status, CANCELLED)
  alt không hợp lệ (READY, COMPLETED, CANCELLED)
    OS-->>KH: 409 INVALID_TRANSITION
  else hợp lệ (PENDING, PAYMENT_FAILED, PAID)
    OS->>ST: release(items)
    ST->>DB: UPDATE products SET stock = stock + qty
    OS->>DB: UPDATE order status = CANCELLED, COMMIT
    OS-->>KH: 201 order CANCELLED
  end
  end
  rect rgb(232,240,228)
  Note over KH,DB: B. Nhân viên cập nhật trạng thái pha chế
  NV->>OC: PATCH /orders/:id/status {status: PREPARING}
  OC->>OC: RolesGuard (@Roles STAFF) – khách → 403
  OC->>OS: staffUpdate(id, PREPARING)
  alt status ∈ {PAID, PENDING, PAYMENT_FAILED}
    OS-->>NV: 400 (không được đặt tay)
  else PREPARING / READY / COMPLETED / CANCELLED
    OS->>DB: SELECT FOR UPDATE + assertTransition
    OS->>DB: UPDATE status
    OS-->>NV: 200 order mới
  end
  end
